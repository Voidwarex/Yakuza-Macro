# Copy to .env (or export these / put them in your systemd unit) before running.

# Recommended: a long random string so login cookies survive restarts.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: where the SQLite database lives (default server/power.db).
DB_PATH=

# Optional: bind address. Keep 127.0.0.1 when behind nginx (recommended).
HOST=127.0.0.1
PORT=8000

# Public base URL of the panel — used for Stripe redirect links.
PUBLIC_URL=https://api.amos.fyi

# Leave UNSET in production. Set to 1 only for local http testing (otherwise the
# browser won't send the Secure login cookie).
# INSECURE_COOKIES=1

# ---- Stripe (billing). Leave blank to run without payments; upgrade buttons
# then show "billing not configured". ----
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (/billing/webhook), from
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs you create in Stripe for each paid plan (price_...).
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
