# Copy to .env (or export these in your shell / systemd unit) before running.

# Required: the password for the web control panel.
ADMIN_PASSWORD=choose-a-strong-password

# Recommended: a long random string so login cookies survive restarts.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: where the SQLite database lives (default server/power.db).
DB_PATH=

# Optional: bind address. Keep 127.0.0.1 when behind nginx (recommended).
HOST=127.0.0.1
PORT=8000
